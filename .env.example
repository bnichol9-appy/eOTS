# Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Random secret used to sign session and unlock cookies. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Neon Postgres. On Vercel the Neon integration sets this automatically.
# Leave it unset locally and the app uses an embedded PGlite database in ./.pglite instead.
DATABASE_URL=

# Vercel Blob for photos. On Vercel the Blob integration sets this automatically.
# Leave it unset locally and photos are stored in ./.uploads instead.
BLOB_READ_WRITE_TOKEN=

# Optional
EOTS_MODEL=claude-opus-5-5

# Push notifications (optional). Generate a pair with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the scheduled nudge job (/api/cron/nudges). Vercel sends it automatically when set.
CRON_SECRET=
