# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000
# Where PIN config, the database and photos are stored
EOTS_DATA_DIR=./data
# Model used for idea generation and photo analysis
EOTS_MODEL=claude-opus-5-5
# Set to "true" when running behind HTTPS (marks the session cookie Secure)
EOTS_SECURE_COOKIES=false
